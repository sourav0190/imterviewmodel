# ====================================================================
# AiProtctor - Interview Intelligence Agent Configuration
# ====================================================================

# Environment Mode: development | staging | production
APP_ENV=development

# LLM Evaluation Configuration
# Options: mock | deterministic | openai
# When set to 'openai', INTERVIEW_LLM_API_KEY (or OPENAI_API_KEY) must be provided.
INTERVIEW_LLM_PROVIDER=mock
INTERVIEW_LLM_API_KEY=
# Fallback standard env var also recognized if INTERVIEW_LLM_API_KEY is unset:
# OPENAI_API_KEY=your-openai-api-key-here
INTERVIEW_LLM_BASE_URL=
INTERVIEW_LLM_MODEL=gpt-4o-mini
INTERVIEW_LLM_TIMEOUT_SECONDS=30.0
INTERVIEW_LLM_MAX_CONCURRENCY=3

# Speech-to-Text (STT) Configuration
# Options: mock | whisper
# When set to 'whisper', INTERVIEW_STT_API_KEY (or OPENAI_API_KEY) must be provided.
INTERVIEW_STT_PROVIDER=mock
INTERVIEW_STT_API_KEY=
INTERVIEW_STT_MODEL=whisper-1
INTERVIEW_STT_LANGUAGE=en

# Privacy & Audio Retention Policies (GDPR / FERPA Compliance)
# Default is false: Raw audio is processed in RAM and never saved to disk.
INTERVIEW_AUDIO_RETENTION_ENABLED=false
INTERVIEW_AUDIO_STORAGE_PATH=storage/interview_audio
INTERVIEW_MAX_AUDIO_CHUNK_BYTES=2097152

# Authentication & Verified Identity (JWT / OIDC & Server API Key)
# Option A: Cryptographic JWT Verification (Recommended for Staging & Production)
# Configure an OIDC / Identity Provider (Auth0, Supabase, Keycloak, Okta)
JWT_AUTH_ENABLED=true
JWT_ISSUER=https://auth.example.com/
JWT_AUDIENCE=aiproctor-api
JWT_JWKS_URL=https://auth.example.com/.well-known/jwks.json
# Alternatively, provide public key (PEM) or symmetric secret:
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# JWT_SECRET=your-symmetric-hmac-secret-for-staging
JWT_ALGORITHMS=RS256,ES256,HS256
WS_TICKET_EXPIRY_SECONDS=60

# Option B: Server-to-Server Pre-Shared API Key
# In production (APP_ENV=production), either JWT verification or INTERVIEW_API_KEY is required.
# Requests can include header 'Authorization: Bearer <jwt>' or 'X-API-Key: <key>'
INTERVIEW_API_KEY=your-secure-api-key-here
# Set to true only for local development/offline testing; automatically forced to false when APP_ENV=production
INTERVIEW_ALLOW_ANONYMOUS_DEV=true

# Cross-Origin Resource Sharing (CORS) Configuration
# Comma-separated list of allowed origins. Wildcard '*' is strictly prohibited in production when credentials are used.
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000


# ====================================================================
# Database Persistence (PostgreSQL / SQLAlchemy 2.x)
# ====================================================================
# Options: memory | postgres
# When APP_ENV=production, persistence_backend is strictly required to be 'postgres'
# and DATABASE_URL must be specified. In-memory storage is prohibited in production.
INTERVIEW_PERSISTENCE_BACKEND=postgres

# PostgreSQL Connection URL (standard or psycopg driver):
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aiproctor

